# Copy to .env.local (your PC) or .env.stockholm (the VPS). Both are git-ignored: never commit them.
# Real secrets (Polymarket keys, later phases) go only in the VPS copy, chmod 600.

# local | stockholm
APP_ENV=local
# development | backtest | replay | paper | shadow | live
TRADING_MODE=paper
# Must be true together with TRADING_MODE=live, and only then. Live is refused until the execution phase exists.
EXECUTION_ENABLED=false
MARKET_DATA_ENABLED=true
PREDICTION_ENABLED=true
RISK_ENGINE_ENABLED=true

POSTGRES_USER=polygemy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=polygemy
POSTGRES_PORT=5432
# For tools run on the host (cargo run, python). Containers build their own URL from the values above.
DATABASE_URL=postgres://polygemy:change-me@127.0.0.1:5432/polygemy
TEST_DATABASE_URL=postgres://polygemy:change-me@127.0.0.1:5432/polygemy_test
DB_MAX_CONNECTIONS=10

# json | pretty
LOG_FORMAT=json
LOG_LEVEL=info
ENV_FILE=.env.local

# ---------------------------------------------------------------- market data (Phase 2)
# Subset of: binance,coinbase,deribit,chainlink,polymarket
FEEDS_ENABLED=binance,coinbase,deribit,chainlink,polymarket
# A market only becomes READY when these feeds are healthy (names: binance, coinbase, deribit,
# chainlink_spot, chainlink_twap60, polymarket). The 5m BTC markets settle on Chainlink's 60 s TWAP.
REQUIRED_FEEDS=polymarket,chainlink_twap60
# Polymarket CLOB API credentials: required for Chainlink prices (PolyBolt). Read-only use here.
# Derive them once from your Polymarket wallet (see docs/OPERATIONS.md). Never commit them.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_SERIES_SLUG=btc-up-or-down-5m
# A feed with no valid message for this long is STALE and unusable for decisions.
FEED_STALE_MS=5000
MARKET_WINDOW_SECS=300
PRELOAD_LEAD_SECS=60
ENTRY_CUTOFF_SECS=30
DISCOVERY_INTERVAL_SECS=15
DISCOVERY_LOOKAHEAD_SECS=600
PERSIST_QUEUE_CAPACITY=100000
# Optional Deribit dated futures tickers, e.g. BTC-26DEC26
DERIBIT_EXTRA_TICKERS=
# Endpoints default to the official public URLs; override only with other official endpoints:
# BINANCE_WS_URL BINANCE_REST_URL BINANCE_SYMBOL COINBASE_WS_URL COINBASE_PRODUCT DERIBIT_WS_URL
# DERIBIT_INSTRUMENT POLYMARKET_WS_URL POLYBOLT_WS_URL GAMMA_API_URL CLOB_API_URL

# ---------------------------------------------------------------- storage (small-storage mode)
# Raw events and book snapshots are kept this many hours (hourly partitions), then dropped.
RAW_RETENTION_HOURS=24
# Per-level book deltas are ~50 GB/day; keep false unless you have the disk. Live books are unaffected.
STORE_BOOK_DELTAS=false
# Above 80% of this the oldest raw partitions are dropped early (never the last 2 hours).
DB_SIZE_BUDGET_GB=20

# Simulated trading on live data in paper/shadow mode (features and predictions run either way).
PAPER_TRADING_ENABLED=true
